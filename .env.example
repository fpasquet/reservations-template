# Copié en .env par make install. Valeurs de développement local seulement.

# Postgres de Docker Compose (port 5435 sur la machine)
POSTGRES_PORT=5435
DATABASE_URL=postgresql://reservations:reservations@localhost:5435/reservations

# API (apps/api) : port d'écoute ; CORS limité à l'adresse de l'interface
PORT=4030
APP_URL=http://localhost:3030

# Interface (apps/web) : adresse de l'API, appelée depuis le navigateur et fixée au build
API_URL=http://localhost:4030
